  <actuator>
    <!-- Damiao DM-J4340-2EC (24V) DC-motor model — MuJoCo-native `<dcmotor>`.
         `nominal="V τ_stall ω_no_load"` fully determines K (back-EMF constant) and
         R (terminal resistance):  K = V/ω_no_load = 3.74900 V·s/rad,
         R = V·K/τ_stall = 1.66622 Ω, so MuJoCo integrates
             τ = (K/R)·(v − K·q̇)      [= 2.2500·v − 8.4353·q̇]
         with current saturation implicit in the voltage bound.

         Source values (Damiao official bench curve, 97 points, r²=0.9916):
         stall torque 54 N·m is the curve-derived value (mean error 0.85% against
         the measured points vs 9.94% for the 40 N·m datasheet figure); no-load
         speed 6.4017 rad/s is the measured extrapolation.
         See ~/dm-actuator-model/params/dm_j4340_2ec.yaml (Q1, error 0.85%).

         WHY NOT <position forcerange=±28>: a force-limited position servo is a
         CONSTANT torque ceiling, independent of speed — it delivers its full
         28 N·m even at 20 rad/s, whereas the real motor delivers 0 N·m at
         6.4017 rad/s with a linear falloff in between. That missing τ-ω slope is
         exactly what this variant restores.

         input="voltage": MuJoCo owns the τ-ω + back-EMF physics; the position
         loop lives in the action term (DmVoltageAction), which writes a voltage
         into `ctrl` on EVERY physics substep. That split is what makes the
         applied torque exactly observable in Python — the action term evaluates
         the same closed form on the same state, with no backend hook needed.

         ctrlrange="-24 24" bounds the supply voltage (== the bus voltage in
         `nominal`), i.e. full PWM duty in both directions.

         VERSION NOTE: `input="voltage"` is the MuJoCo 3.11 spelling (this venv is
         3.11.0). 3.12+ replaces it with a space-separated signature list. -->
    <dcmotor name="leg_l1_joint_motor" joint="leg_l1_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_l2_joint_motor" joint="leg_l2_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_l3_joint_motor" joint="leg_l3_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_l4_joint_motor" joint="leg_l4_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_l5_joint_motor" joint="leg_l5_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_r1_joint_motor" joint="leg_r1_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_r2_joint_motor" joint="leg_r2_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_r3_joint_motor" joint="leg_r3_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_r4_joint_motor" joint="leg_r4_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
    <dcmotor name="leg_r5_joint_motor" joint="leg_r5_joint" nominal="24 54 6.4017" input="voltage" ctrlrange="-24 24"/>
  </actuator>

