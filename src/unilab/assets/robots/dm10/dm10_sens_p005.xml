  <actuator>
    <!-- SIMULATION gains — aligned to the Damiao humanoid-gym config that walks
         (miao_armhalf_config.py stiffness=30 / damping=3.0). The real-robot
         deployment gains (kp 16-20) are TOO SOFT for MuJoCo: the position
         actuator kp must be much higher to drive the virtual leg forcibly
         enough to produce real forward propulsion (kp<20 → soft legs → hops
         in place instead of walking). -->
    <position name="leg_l1_joint_motor" joint="leg_l1_joint" kp="30.015" kv="3.000"/>
    <position name="leg_l2_joint_motor" joint="leg_l2_joint" kp="30.015" kv="3.000"/>
    <position name="leg_l3_joint_motor" joint="leg_l3_joint" kp="30.015" kv="3.000"/>
    <position name="leg_l4_joint_motor" joint="leg_l4_joint" kp="30.015" kv="3.000"/>
    <position name="leg_l5_joint_motor" joint="leg_l5_joint" kp="30.015" kv="3.000"/>
    <position name="leg_r1_joint_motor" joint="leg_r1_joint" kp="30.015" kv="3.000"/>
    <position name="leg_r2_joint_motor" joint="leg_r2_joint" kp="30.015" kv="3.000"/>
    <position name="leg_r3_joint_motor" joint="leg_r3_joint" kp="30.015" kv="3.000"/>
    <position name="leg_r4_joint_motor" joint="leg_r4_joint" kp="30.015" kv="3.000"/>
    <position name="leg_r5_joint_motor" joint="leg_r5_joint" kp="30.015" kv="3.000"/>
  </actuator>

  <sensor>
