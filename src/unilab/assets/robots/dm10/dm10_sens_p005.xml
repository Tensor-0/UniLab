    <accelerometer site="imu_in_torso" name="torso_acceleration" cutoff="157" noise="0.01"/>
    <framezaxis objtype="site" objname="imu_in_torso" name="torso_upvector"/>

    <framepos objtype="site" objname="left_foot" name="left_foot_pos"/>
    <framequat objtype="site" objname="left_foot" name="left_foot_quat"/>
    <framezaxis objtype="site" objname="left_foot" name="left_foot_upvector"/>

    <framepos objtype="site" objname="right_foot" name="right_foot_pos"/>
