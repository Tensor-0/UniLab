  <!-- Damiao bipedal lower-body, 10 DoF (leg_l1-5 + leg_r1-5), derived from the
       official miao_arm MJCF (bipedal-robot repo). Arms and waist yaw removed
       per project decision; waist link kept as a fixed (jointless) connection so
       leg mounting frames and inertials stay identical to the official model.

       VARIANT ``dm10_actuator``: body/inertia geometry is bit-identical to
       ``dm10.xml``; ONLY the actuator model differs. ``dm10.xml`` keeps the
       constant-torque <position> servo (forcerange ±28 N·m, torque independent of
       speed); this file uses the real DM-J4340-2EC torque-speed curve. The two
       must both exist so A/B measurements keep a baseline arm — see
       ~/UniLab/HANDOFF-dm10-actuator.md. -->
  <!-- DYNAMIC MODEL SOURCE: this file is NOT copied by dm10-motion-tracking's
       scripts/install_to_unilab.sh (which only ships config/*.py|yaml + motions),
       so UniLab is its only copy. Keep the baseline ``dm10.xml`` untouched. -->
  <option timestep="0.001" iterations="50" solver="PGS" gravity="0 0 -9.81"/>
  <compiler angle="radian" autolimits="true" meshdir="assets"/>

  <default>
    <joint limited="true" armature="0.05" damping="0.01"/>
    <!-- Deliberately NO actuator default block. A `<position forcerange=...>` here
         would be SILENTLY INHERITED by <dcmotor>, capping it at that constant
         instead of the real torque-speed curve — MuJoCo accepts forcerange on
         <dcmotor> only through defaults (inline it rejects as "unrecognized
         attribute"). Verified 2026-09-17: with the default present,
         forcelimited=True / forcerange=[-28 28]; without it, forcelimited=False. -->
  </default>

